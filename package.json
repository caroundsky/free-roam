{
  "name": "@caroundsky/free-roam",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "version": "0.1.0",
  "description": "通用漫游引导组件",
  "main": "./dist-lib/free-roam.umd.js",
  "module": "./dist-lib/free-roam.es.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/free-roam.es.js",
      "require": "./dist-lib/free-roam.umd.js"
    },
    "./style.css": "./dist-lib/free-roam.css"
  },
  "files": [
    "dist-lib"
  ],
  "sideEffects": [
    "*.css",
    "*.less",
    "*.vue"
  ],
  "scripts": {
    "serve": "vite --mode development",
    "build": "vue-tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "build:test": "vite build --mode test",
    "build:prod": "vite build --mode production",
    "build:lib": "vue-tsc --noEmit && vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.29.0",
    "@typescript-eslint/parser": "^5.29.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "autoprefixer": "^10.4.7",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^8.5.1",
    "eslint-define-config": "^1.5.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^9.1.1",
    "less": "^4.9.1",
    "postcss": "^8.4.14",
    "prettier": "^2.7.1",
    "stylelint": "^14.9.1",
    "stylelint-config-css-modules": "^4.1.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-recess-order": "^3.0.0",
    "stylelint-config-standard": "^26.0.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
